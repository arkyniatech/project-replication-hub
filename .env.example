# Copie este arquivo para .env (ou .env.local) e preencha com valores reais.
# NUNCA versionar o arquivo preenchido — apenas este .env.example com placeholders.

# --- Supabase (obrigatório) ---
# Painel Supabase > Settings > API
VITE_SUPABASE_URL=<URL_DO_PROJETO_SUPABASE>
VITE_SUPABASE_PUBLISHABLE_KEY=<CHAVE_PUBLICA_ANON_DO_PROJETO>
# ID do projeto Supabase (Painel > Settings > General > Reference ID)
VITE_SUPABASE_PROJECT_ID=<REFERENCE_ID_DO_PROJETO_SUPABASE>

# --- Feature flags (opcional) ---
# Exige verificação de WhatsApp ao cadastrar cliente ('true' ou 'false')
VITE_REQUIRE_WHATSAPP_VERIFICATION=<true_ou_false>

# --- Auth0 (legado, não utilizado no código atual — mantido por compatibilidade de tipos) ---
# VITE_AUTH0_DOMAIN=<DOMINIO_AUTH0>
# VITE_AUTH0_CLIENT_ID=<CLIENT_ID_AUTH0>

# --- Testes E2E (opcional, só para rodar Playwright) ---
# Credenciais de conta de teste. NUNCA versionar valores reais.
E2E_EMAIL_ADMIN=<EMAIL_DA_CONTA_ADMIN_DE_TESTE>
E2E_SENHA_ADMIN=<SENHA_DA_CONTA_ADMIN_DE_TESTE>
E2E_EMAIL_VENDEDOR=<EMAIL_DA_CONTA_VENDEDOR_DE_TESTE>
E2E_SENHA_VENDEDOR=<SENHA_DA_CONTA_VENDEDOR_DE_TESTE>
E2E_BASE_URL=<URL_DO_AMBIENTE_A_TESTAR>

# --- NÃO incluir aqui ---
# VITE_SUPABASE_SERVICE_ROLE_KEY: docs/setup.md menciona essa variável, mas isso
# está ERRADO. Qualquer variável prefixada com VITE_ é publicada no bundle do
# frontend pelo Vite. A service_role key nunca deve existir no frontend — ela
# pertence apenas aos secrets das Edge Functions (supabase/functions/*), gerenciados
# via `supabase secrets set`, nunca via .env do Vite.
